{
  "name": "seekers-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview -c wrangler.dev.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "import:epgp": "tsx scripts/import-epgp.ts",
    "snapshot": "scripts/snapshot.sh",
    "verify": "tsx scripts/verify-harness.ts",
    "backfill:expansion-decay": "tsx scripts/backfill-expansion-decay.ts",
    "verify:expansion-decay": "tsx scripts/verify-expansion-decay.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.1",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@opennextjs/cloudflare": "^1.19.9",
    "better-auth": "^1.7.1",
    "better-auth-cloudflare": "^0.3.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "react": "^19.1.7",
    "react-dom": "^19.1.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.7.4",
    "wrangler": "^4.123.0"
  }
}
