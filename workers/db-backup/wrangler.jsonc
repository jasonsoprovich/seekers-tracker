/**
 * Standalone Worker — deliberately NOT part of the main seekers-tracker
 * Worker's build. The main app's Worker entrypoint is generated by
 * OpenNext on every build (.open-next/worker.js); bolting a scheduled
 * handler onto that generated file would mean re-patching it after every
 * `opennextjs-cloudflare build`, and a mistake there risks the whole
 * site. A cron job that only touches D1 export/R2 has no reason to share
 * a deploy with the request-serving app at all — see
 * https://developers.cloudflare.com/workflows/examples/backup-d1/, the
 * pattern this follows almost exactly.
 *
 * Deploy from this directory: `npx wrangler deploy` (resolves the root
 * repo's wrangler via node_modules). One manual step first — see
 * README.md: create a Cloudflare API token scoped to D1:Edit and run
 * `npx wrangler secret put D1_REST_API_TOKEN`.
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "seekers-tracker-db-backup",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-16",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		// Account ID isn't secret (it's visible in every dashboard URL); the
		// D1 export API needs it. The actual credential is
		// D1_REST_API_TOKEN, set via `wrangler secret put` — never here.
		"ACCOUNT_ID": "a12d86f29792323791c2fdc101759089",
		"DATABASE_ID": "77583c9c-c654-4934-8782-ed4d1265771f",
		// How many nightly snapshots to keep — disaster-recovery hedge
		// alongside D1's own Time Travel (30-day point-in-time restore on
		// Workers Paid, already on regardless of this Worker), not a
		// replacement for it. These are portable, downloadable SQL dumps.
		"KEEP_COUNT": "7"
	},
	"workflows": [
		{
			"name": "seekers-db-backup",
			"binding": "BACKUP_WORKFLOW",
			"class_name": "BackupWorkflow"
			// No "schedules" yet — scheduled Workflows require a paid Workers
			// plan (this account is on Free) and deploy fails outright if
			// present without one. Until upgraded, trigger a backup manually:
			// `npx wrangler workflows trigger seekers-db-backup` from this
			// directory (see README.md). Add back
			// `"schedules": ["0 9 * * *"]` (09:00 UTC = 3-4am US Central,
			// off-peak for this guild) once the plan is upgraded, then
			// redeploy.
		}
	],
	"r2_buckets": [
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "seekers-of-souls-db-backups"
		}
	],
	"observability": {
		"enabled": true
	}
}
